APP_NAME=FUTURIST OS
ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://futurist:futurist@localhost:5432/futurist_os
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet key for encrypting secrets at rest (e.g. MCP server env vars, Phase 9). Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left empty, secrets are stored in plaintext with a logged warning - fine for local dev,
# not for production.
ENCRYPTION_KEY=

# Model providers (all optional - agents fall back to whichever have keys configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY also drives embeddings for the knowledge base (Phase 2). Without it,
# embeddings fall back to a deterministic bag-of-words hash - functional for local dev,
# but nowhere near real semantic search quality.

# Browser Automation (Phase 4). Leave empty in Docker (playwright install already puts
# the browser somewhere Playwright finds automatically); only needed for a
# pre-provisioned binary in a nonstandard location (e.g. this sandbox during development).
PLAYWRIGHT_EXECUTABLE_PATH=

# Automation Agent / n8n (Phase 5). With the bundled docker-compose n8n service:
# N8N_BASE_URL=http://n8n:5678, N8N_API_KEY from n8n's UI under Settings > API.
N8N_BASE_URL=
N8N_API_KEY=

# Voice (Phase 6). STT reuses OPENAI_API_KEY (Whisper) - nothing extra needed. TTS is
# ElevenLabs, genuinely optional: leave empty and the frontend uses the browser's own
# speechSynthesis instead (lower quality, but works out of the box).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Observability (Phase 9). Optional - unset, the app logs structured JSON to stdout only.
SENTRY_DSN=

# Google OAuth: Calendar/E-Mail (Phase 7). Create credentials at
# https://console.cloud.google.com under "APIs & Dienste > Anmeldedaten" - OAuth-Client-ID,
# Typ "Webanwendung". GOOGLE_REDIRECT_URI must exactly match an "Autorisierte
# Weiterleitungs-URI" registered there. Optional - unset, the Calendar/Gmail tools report
# "not configured" instead of failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

CORS_ORIGINS=["http://localhost:5173"]
